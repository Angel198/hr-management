# ============================================
# HRMS Application Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values
# For Vercel: Set these in Project Settings → Environment Variables

# ============================================
# REQUIRED - Database Configuration
# ============================================
MONGODB_URI=mongodb+srv://shruti_db_user:Mr2LQGNLr2o7XRxd@hrms.aeuawyb.mongodb.net/HRMS?retryWrites=true&w=majority

# ============================================
# OPTIONAL - Frontend Configuration
# ============================================
# API Base URL (for frontend)
# For Vercel: Set to "/api" to use same domain
# For local dev: Leave empty or set to "http://localhost:5050/api"
VITE_API_URL=/api

# ============================================
# OPTIONAL - Server Configuration
# ============================================
# Server Port (only used in local development, not in Vercel)
PORT=5050

# Node Environment (auto-set by Vercel to "production")
NODE_ENV=production

# ============================================
# OPTIONAL - Email Configuration (SMTP)
# ============================================
# Uncomment and fill these if you want email functionality
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_SECURE=false
# SMTP_FROM=your-email@gmail.com

# ============================================
# OPTIONAL - Application URLs
# ============================================
# Frontend URL (for email links, etc.)
# APP_LOGIN_URL=https://your-app.vercel.app

# ============================================
# OPTIONAL - Security
# ============================================
# Bcrypt salt rounds for password hashing
BCRYPT_SALT_ROUNDS=10

# ============================================
# VERCEL-SPECIFIC
# ============================================
# Vercel automatically sets VERCEL=1 in production
# Don't set this manually

